//-----------------------------------------------------------------------------
// Purpose: Base KV in the start of the soundscape file
//-----------------------------------------------------------------------------
@SoundScapeBaseClass = SoundScapeBase : "Defines a soundscape "
[
    dsp(bool)           : "Enable DSP effects"
    dsp_volume(float)   : "DSP volume multiplier"
    fadein(float)       : "Fade in time"
    playlooping(sound)  : "Looping ambient sound"
]


//-----------------------------------------------------------------------------
// Purpose: Common KV that the rules shares
//-----------------------------------------------------------------------------
@SoundScapeCommonKeyValuesClass = SoundScapeCommonKeyValues : "Defines common keyvalues"
[
    wave(string)        : "The path and filename of the sound to play, relative to game\sound\."
    volume(normal)      : "1 is full power, 0 is silent."
    pitch(integer)      : "Percentage value. 70-130 is the useful range."
    position(0-7)       : "One of eight locations in the world (defined by the mapper) from which a sound can be emitted."
    position(string)    : "As above, but the sound emits from a completely random location near the player. (e.g: random)"
    attenuation(float)  : "How quickly the sound's volume drops as the camera moves away from it. Only relevant with a position specified. Default value is: "1.00". The lower the value is, greater the radius of the sound will be. And the opposite, higher the value is, smaller the radius of the sound will be."
    soundlevel(string)  : "Can be used instead of attenuation. Accepts one of the engine's pre-set values. Warning: Remember to enclose any values with space characters in quote marks."
    suppress_on_restore(bool) : "Prevents sound from restarting upon loading a saved game. It's intended for music played inside soundscape."
]