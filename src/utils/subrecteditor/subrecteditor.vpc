//-----------------------------------------------------------------------------
//	SUBRECTEDITOR.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_qt_win32.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\public;$SRCDIR\public\mathlib\$SRCDIR\public\tier0;$SRCDIR\public\tier1;..\common"
		$PreprocessorDefinitions		"$BASE;"
	}

	$Linker
	{
		$AdditionalDependencies			"$BASE;comctl32.lib;legacy_stdio_definitions.lib"
	}
}

$Project "subrecteditor"
{
	$Folder	"Qt UI Files"
	{
		$File 	"mainwindow.ui"
	}

	$Folder	"Source Files"
	{
		-$File	"$SRCDIR\public\tier0\memoverride.cpp"

		$Folder "Core"
		{
			$File "subrecteditor.cpp"
		}

		$Folder "UI"
		{
			$File "mainwindow.cpp"
		}

		$Folder	"Common Files"
		{
			$File	"..\common\cmdlib.cpp"
			$File	"$SRCDIR\public\filesystem_helpers.cpp"
			$File	"$SRCDIR\public\filesystem_init.cpp"
			$File	"..\common\filesystem_tools.cpp"
			$File	"..\common\scriplib.cpp"
			$File	"..\common\tools_minidump.cpp"
			$File	"$SRCDIR\public\loadcmdline.cpp"
			$File	"$SRCDIR\public\resourcecopy\cresourcecopy.cpp"
		}
	}

	$Folder	"Header Files"
	{
		$Folder "Core"
		{
			$File "coresubrecteditor.hpp"
			$File "subrecteditor.hpp"
		}

		$Folder "UI"
		{
			$File		 "mainwindow.hpp"
			$DynamicFile "$QT_MOC_DIR\ui_mainwindow.h"
		}

		$Folder	"Common header files"
		{
			$File	"..\common\tools_minidump.h"
			$File	"..\common\cmdlib.h"
			$File	"$SRCDIR\public\filesystem_init.h"
			$File	"..\common\filesystem_tools.h"
			$File	"$SRCDIR\public\loadcmdline.h"
			$File	"$SRCDIR\public\resourcecopy\cresourcecopy.hpp"
		}
	}

	$Folder	"Link Libraries"
	{
		$Lib tier2
	}
}
